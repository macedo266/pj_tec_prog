@{
}


@{
    Layout = "_Layout_Login";
}


<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Prime Motors - Login</title>


    <!-- =================================================
         BOOTSTRAP
    ================================================== -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">


    <!-- =================================================
         BOOTSTRAP ICONS
    ================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


    <!-- =================================================
         CSS
    ================================================== -->

    <style>

        * {
            box-sizing: border-box;
        }


        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
        }


        /* =========================
                   TELA DE LOGIN
                ========================== */

        .tela-login {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: linear-gradient( rgba(0, 0, 0, 0.70), rgba(0, 0, 0, 0.70) ), url("https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1600&q=80");
            background-size: cover;
            background-position: center;
        }


        /* =========================
                   CAIXA DE LOGIN
                ========================== */

        .login-box {
            width: 100%;
            max-width: 420px;
            background-color: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.30);
        }


        /* =========================
                   ÍCONE
                ========================== */

        .login-icon {
            width: 70px;
            height: 70px;
            margin: 0 auto 15px;
            border-radius: 50%;
            background-color: #111827;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
        }


        /* =========================
                   LOGO
                ========================== */

        .logo {
            text-align: center;
            font-size: 30px;
            font-weight: bold;
            margin-bottom: 30px;
        }


            .logo span {
                color: #dc2626;
            }


        /* =========================
                   LABEL
                ========================== */

        .form-label {
            font-weight: bold;
        }


        /* =========================
                   BOTÃO
                ========================== */

        .btn-danger {
            background-color: #dc2626;
            border: none;
        }


            .btn-danger:hover {
                background-color: #b91c1c;
            }


        /* =========================
                   LINK
                ========================== */

        .voltar-site {
            color: #0d6efd;
            text-decoration: none;
        }


            .voltar-site:hover {
                text-decoration: underline;
            }


        /* =========================
                   MOBILE
                ========================== */

        @@media (max-width: 768px) {
            .login-box

        {
            padding: 30px 20px;
        }

        }
    </style>

</head>


<body>


    <!-- =================================================
         TELA DE LOGIN
    ================================================== -->

    <div class="tela-login">


        <!-- =================================================
             CAIXA
        ================================================== -->

        <div class="login-box">


            <!-- ÍCONE -->

            <div class="login-icon">

                <i class="bi bi-person-lock"></i>

            </div>


            <!-- LOGO -->

            <div class="logo">

                Prime<span>Motors</span>

            </div>


            <!-- TÍTULO -->

            <h4 class="text-center mb-4">

                Área restrita

            </h4>


            <!-- =================================================
                 FORMULÁRIO DE LOGIN
            ================================================== -->

            <form onsubmit="entrar(event)">


                <!-- USUÁRIO -->

                <div class="mb-3">

                    <label for="usuario"
                           class="form-label">

                        Usuário

                    </label>


                    <input type="text"
                           id="usuario"
                           class="form-control"
                           placeholder="Digite seu usuário"
                           autocomplete="username"
                           required>

                </div>


                <!-- SENHA -->

                <div class="mb-3">

                    <label for="senha"
                           class="form-label">

                        Senha

                    </label>


                    <input type="password"
                           id="senha"
                           class="form-control"
                           placeholder="Digite sua senha"
                           autocomplete="current-password"
                           required>

                </div>


                <!-- MENSAGEM DE ERRO -->

                <div id="erro"
                     class="alert alert-danger"
                     style="display: none;">

                    Usuário ou senha inválidos.

                </div>


                <!-- BOTÃO ENTRAR -->

                <button type="submit"
                        class="btn btn-danger w-100">

                    <i class="bi bi-box-arrow-in-right"></i>

                    Entrar

                </button>


            </form>


            <!-- =================================================
                 VOLTAR PARA O SITE
            ================================================== -->

            <div class="text-center mt-4">

                <a href="index.html"
                   class="voltar-site">

                    <i class="bi bi-arrow-left"></i>

                    Voltar para o site

                </a>

            </div>


        </div>

    </div>


    <!-- =================================================
         JAVASCRIPT DO LOGIN
    ================================================== -->

    <script>

        /*
            =================================================
            LOGIN

            Usuário:
            funcionario

            Senha:
            123456
            =================================================
        */

        function entrar(event) {

            event.preventDefault();


            const usuario =
                document.getElementById("usuario").value.trim();


            const senha =
                document.getElementById("senha").value;


            const erro =
                document.getElementById("erro");


            /*
                Verifica os dados.
            */

            if (
                usuario === "funcionario" &&
                senha === "123456"
            ) {


                /*
                    Registra que o usuário
                    realizou o login.
                */

                sessionStorage.setItem(
                    "usuarioLogado",
                    "true"
                );


                /*
                    Abre a área restrita.
                */

                window.location.href =
                    "area_restrita.html";


            } else {


                /*
                    Mostra mensagem de erro.
                */

                erro.style.display = "block";


                /*
                    Limpa somente a senha.
                */

                document.getElementById("senha").value = "";


                /*
                    Coloca o cursor no campo
                    de senha.
                */

                document.getElementById("senha").focus();

            }

        }

    </script>


    <!-- =================================================
         BOOTSTRAP JS
    ================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


</body>

</html>